# Copy to .env.local and fill in real values. Never commit the filled-in copy.
# The app fails to start rather than falling back to defaults, so all of these
# must be set.

# --- Database ---
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# --- Auth ---
# Required. Without it the server falls back to a well-known development value,
# which would let anyone mint a valid admin token.
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# --- CORS ---
# Comma-separated. Only needed for origins other than the one serving the app.
ALLOWED_ORIGINS=

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage ---
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Email ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who receives support-ticket notifications (comma-separated).
TICKET_NOTIFY_EMAILS=aiteam@fluid.live,meetpandya@fluid.live,rohnit@fluid.live

# AiSensy campaign whose template carries the booking link as a body variable,
# e.g. "Hi {{1}}, book your session here: {{2}}". Set it and the WhatsApp
# message carries the prefilled /book?name=...&phone=... URL; leave it blank and
# WhatsApp falls back to the generic no-variable template (email still carries
# the full link either way).
AISENSY_BOOKING_LINK_CAMPAIGN=

# --- Frontend ---
FRONTEND_URL=
# Dev only: point the vite proxy at a deployed API instead of a local one.
VITE_API_TARGET=http://localhost:3001
