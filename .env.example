# Copy to .env.local and fill in real values. Never commit the filled-in copy.
# The app fails to start rather than falling back to defaults, so all of these
# must be set.

# --- Database ---
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# --- Auth ---
# Required. Without it the server falls back to a well-known development value,
# which would let anyone mint a valid admin token.
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# --- Dashboard access control ---
# Who may see and edit the Roles tab. An identity list, not a role: the AI team
# signs in as `admin`, the same role it has to be distinguished from.
ACCESS_ADMIN_USERS=aiteam@fluid.live,aiteam
# Whether the blanket scope gate BLOCKS or only reports. Leave unset to run in
# shadow mode — it logs "[access] SHADOW would deny …" and lets the request
# through. Read those logs, confirm they are all genuine, then set this to true.
# Routes with an explicit requireScope/requireRole are enforced either way.
ACCESS_ENFORCE=

# Initial password for the Fluidadmin account, seeded as a normal users row on
# first boot. Leave blank and it falls back to the old hardcoded password so an
# existing deployment keeps working — that one is in git history, so change it
# from the panel immediately after.
FLUIDADMIN_PASSWORD=

# --- CORS ---
# Comma-separated. Only needed for origins other than the one serving the app.
ALLOWED_ORIGINS=

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage ---
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Email ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who receives support-ticket notifications (comma-separated).
TICKET_NOTIFY_EMAILS=aiteam@fluid.live,meetpandya@fluid.live,rohnit@fluid.live

# AiSensy campaigns that carry the booking link. Every one of these templates
# takes the link as a BODY variable — "Hi {{1}}, book your session here: {{2}}"
# — never on a URL button: a static button rejects a parameter and a dynamic one
# can only append to its approved prefix, so neither can carry a whole address.
#
# Which campaign is used depends on how much the admin prefilled. The first two
# have working defaults in code; set these only to point at different templates.
#
# Basic details prefilled, client picks therapy and therapist:
AISENSY_BOOKING_LINK_CLIENT_CHOOSE=basic_details_prefilled_booking_link
# Basic details and therapy prefilled, client picks the therapist:
AISENSY_BOOKING_LINK_CLIENT_THERAPY=prefilled_therapist_booking_link
# Everything pinned — no dedicated template yet. Leave blank and WhatsApp falls
# back to the generic no-variable prompt without the link (email still carries
# the full link either way).
AISENSY_BOOKING_LINK_CAMPAIGN=

# --- Frontend ---
# Where the separate CRM application is served. The dashboard switcher sends users
# there with a one-time handoff ticket, since it is a different origin and cannot
# read this one'"'"'s stored token. Leave blank to fall back to the panel'"'"'s embedded /crm.
VITE_CRM_URL=http://localhost:3000
FRONTEND_URL=
# Dev only: point the vite proxy at a deployed API instead of a local one.
VITE_API_TARGET=http://localhost:3001
