backups/

# Local database scratch scripts (check_*/list_*/diagnose/test_*).
# Several embedded live DB credentials inline rather than reading process.env,
# which is how they nearly reached a public repo. They are throwaway debugging
# aids, never imported by the app.
panel-backend/check_*.ts
panel-backend/list_*.ts
panel-backend/diagnose.ts
panel-backend/test_*
panel-backend/test.js
# Same throwaways, .ts flavour (test.ts, test2.ts, test3.ts …).
panel-backend/test.ts
panel-backend/test[0-9]*.ts

# Contains a real production VPS SSH private key plus the full secret set
# (PGPASSWORD, JWT_SECRET, live Razorpay key + secret, MinIO keys). Never commit.
add-github-secrets.sh
# Hardcoded admin account passwords.
panel-backend/test-login.js
scripts/updatePasswordsCapitalized.ts
